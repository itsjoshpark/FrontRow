{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" couldn't be opened. It may have been moved or deleted." : {
      "comment" : "Alert message shown when a recent file can no longer be found",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" لا يمكن فتحه. ربما تم نقلها أو حذفها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" nelze otevřít. Možná byl přesunut nebo odstraněn."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" kunne ikke åbnes. Det kan være blevet flyttet eller slettet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" konnte nicht geöffnet werden. Es wurde möglicherweise verschoben oder gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" δεν μπορούσε να ανοίξει. Μπορεί να έχει μετακινηθεί ή διαγραφεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir \"%@. Puede que se haya movido o eliminado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ei voitu avata. Se on voitu siirtää tai poistaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La «%@» n'a pas pu être ouverte. Elle a peut-être été déplacée ou supprimée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%@\" couldn't be opened. It may have been moved or deleted."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%@\" couldn't be opened. It may have been moved or deleted."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" non poteva essere aperto. Potrebbe essere stato spostato o cancellato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" を開けませんでした。移動または削除された可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%@\" couldn't be opened. It may have been moved or deleted."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" kon niet worden geopend. Het is mogelijk verplaatst of verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" nie można otworzyć. Może zostać przeniesiony lub usunięty."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" nu a putut fi deschis. Este posibil să fi fost mutat sau șters."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" не может быть открыт. Возможно, он был перемещен или удален."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" kunde inte öppnas. Det kan ha flyttats eller tagits bort."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%@\" couldn't be opened. It may have been moved or deleted."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\" Не вдалося відкрити%@\". Можливо, його переміщено або видалено."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%@\" couldn't be opened. It may have been moved or deleted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 无法打开。它可能已被移动或删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%@\" couldn't be opened. It may have been moved or deleted."
          }
        }
      }
    },
    "\"%@\" is on \"%@\", which isn't connected. Connect it and try again." : {
      "comment" : "Alert message shown when a recent file's drive or network share is not mounted",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\" هو على \"%2$@\"، وهو غير متصل. قم بتوصيل و حاول مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" je zapnutý \"%2$@\", který není připojen. Připojte ho a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" er på \"%2$@\", som ikke er forbundet. Forbind den og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" ist auf \"%2$@\", was nicht verbunden ist. Verbinde es und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" είναι στο \"%2$@\", το οποίο δεν είναι συνδεδεμένο. Συνδέστε το και προσπαθήστε ξανά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is on \"%2$@\", which isn't connected. Connect it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" está en \"%2$@\", que no está conectado. Conéctalo y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" on käytössä \"%2$@\", jota ei ole yhdistetty. Yhdistä ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" est sur \"%2$@\", ce qui n'est pas connecté. Connectez-le et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is on \"%2$@\", which isn't connected. Connect it and try again."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is on \"%2$@\", which isn't connected. Connect it and try again."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" è su \"%2$@\", che non è connesso. Collegalo e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" が \"%2$@\" 上にあり、接続されていません。接続して再度お試し下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is on \"%2$@\", which isn't connected. Connect it and try again."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" is aan \"%2$@\", welke niet is verbonden. Sluit het aan en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" jest na \"%2$@\", który nie jest połączony. Podłącz go i spróbuj ponownie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" este pe \"%2$@\", care nu este conectat. Conectaţi-l şi încercaţi din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" на \"%2$@\", который не подключен. Подключите его и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" är på \"%2$@\", som inte är ansluten. Anslut den och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is on \"%2$@\", which isn't connected. Connect it and try again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" на \"%2$@, який не підключений. Підключіть його і повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
