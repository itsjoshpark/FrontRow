    "\"%@\" was converted to \"%@\". The original file isn't needed anymore and can be moved to trash." : {
      "comment" : "Alert message shown after a file has been converted",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" wurde in \"%@\" konvertiert. Die Originaldatei wird nicht mehr benötigt und kann in den Papierkorb gelegt werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" a été converti en \"%@\". Le fichier d'origine n'est plus nécessaire et peut être placé dans la corbeille."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" se convirtió en \"%@\". El archivo original ya no es necesario y se puede mover a la papelera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" è stato convertito in \"%@\". Il file originale non serve più e può essere spostato nel Cestino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is geconverteerd naar \"%@\". Het originele bestand is niet meer nodig en kan naar de prullenmand worden verplaatst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" blev konverteret til \"%@\". Den oprindelige fil er ikke længere nødvendig og kan flyttes til papirkurven."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" konverterades till \"%@\". Originalfilen behövs inte längre och kan flyttas till papperskorgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" został przekonwertowany na \"%@\". Oryginalny plik nie jest już potrzebny i można go przenieść do Kosza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" сконвертирован в \"%@\". Оригинальный файл больше не нужен, его можно переместить в Корзину."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" dosyası \"%@\" olarak dönüştürüldü. Özgün dosya artık gerekli değil ve çöp sepetine taşınabilir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" を \"%@\" に変換しました。元のファイルは不要になったため、ゴミ箱に入れることができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"이(가) \"%@\"(으)로 변환되었습니다. 원본 파일은 더 이상 필요하지 않으며 휴지통으로 옮길 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 已转换为 \"%@\"。原始文件不再需要，可以移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 已轉換為 \"%@\"。原始檔案不再需要，可以移到垃圾桶。"
          }
        }
      }
    },
